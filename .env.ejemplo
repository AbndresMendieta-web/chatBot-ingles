# Copie este archivo con el nombre .env y complete sus valores.
# El archivo .env contiene su llave: no lo comparta ni lo suba a un repositorio.

# ---------- Modelo local (Ollama) ----------
LOCAL_URL=http://localhost:11434/v1
LOCAL_KEY=ollama
LOCAL_MODELO=llama3.2
# Como pedir respuestas en JSON: json_schema (estructura garantizada), json_object o ninguno.
LOCAL_FORMATO=json_schema

# ---------- Modelo en la nube (cualquier proveedor compatible con OpenAI) ----------
NUBE_URL=https://api.groq.com/openai/v1
NUBE_KEY=pegue_aqui_su_llave
NUBE_MODELO=openai/gpt-oss-20b
NUBE_FORMATO=json_schema
# Solo para modelos de razonamiento (low, medium o high). Si su modelo no lo usa, deje el valor vacio.
NUBE_RAZONAMIENTO=low
# Precio en dolares por millon de tokens, segun la pagina de precios de su proveedor.
NUBE_PRECIO_ENTRADA=0.075
NUBE_PRECIO_SALIDA=0.30
